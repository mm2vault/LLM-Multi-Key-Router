APP_ENV=development
DATABASE_PATH=./data/router.db
MASTER_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
# Bootstrap admin account. Set real values only in your private host environment.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
# Optional legacy admin header key; generate a random value of 32+ characters if used.
ADMIN_API_KEY=
SESSION_DAYS=14
DEFAULT_USER_REQUEST_LIMIT=0
DEFAULT_USER_TOKEN_LIMIT=0
CORS_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT=90
MAX_KEY_ATTEMPTS=20
COOLDOWN_SECONDS=60
